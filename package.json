{
  "name": "flowscript-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --dir apps/extension dev",
    "playground:dev": "pnpm --dir apps/playground dev",
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:build": "pnpm --dir apps/docs build",
    "docs:preview": "pnpm --dir apps/docs preview",
    "build": "pnpm --dir apps/extension build",
    "compile": "pnpm --dir apps/extension compile",
    "test": "vitest run",
    "test:e2e": "pnpm --dir apps/extension-e2e test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
