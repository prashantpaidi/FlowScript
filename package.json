{
  "name": "flowscript-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/extension dev",
    "docs:dev": "bun --cwd apps/docs dev",
    "docs:build": "bun --cwd apps/docs build",
    "docs:preview": "bun --cwd apps/docs preview",
    "build": "bun --cwd apps/extension build",
    "compile": "bun --cwd apps/extension compile",
    "test": "bun --cwd apps/extension test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
