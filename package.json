{
  "name": "flowscript-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/extension dev",
    "build": "bun --cwd apps/extension build",
    "compile": "bun --cwd apps/extension compile",
    "test": "bun --cwd apps/extension test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
